# =============================================================================
# agent-orchestration-engine -- example configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# =============================================================================

# --- Core ---
ORCH_ENV=local                       # local | ci | production
ORCH_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
ORCH_LOG_FORMAT=console              # console | json  (use json in production)

# --- PostgreSQL (durable source of truth; required) ---
# The engine has no SQLite fallback: PostgreSQL is mandatory.
ORCH_PG_DSN=postgresql+asyncpg://orchestrator:CHANGE_ME@127.0.0.1:5432/orchestration
# Optional: point `alembic upgrade`/`downgrade` at a different database than
# the running application (e.g. a schema-verification database in CI).
# Falls back to ORCH_PG_DSN above when unset.
ORCH_PG_MIGRATIONS_DSN=
ORCH_PG_POOL_SIZE=10
ORCH_PG_MAX_OVERFLOW=5
ORCH_PG_STATEMENT_TIMEOUT_MS=30000

# --- Redis (coordination: locks, event streams, semaphores; required) ---
# db 0 is deliberately avoided so a shared local Redis is never clobbered.
ORCH_REDIS_URL=redis://127.0.0.1:6379/1
ORCH_REDIS_NAMESPACE=orch

# --- pgvector (evidence retrieval) ---
ORCH_EMBEDDING_DIM=768
ORCH_VECTOR_INDEX=hnsw               # hnsw | ivfflat | none

# --- API ---
ORCH_API_HOST=0.0.0.0
ORCH_API_PORT=8000
# Comma-separated API keys accepted by the X-API-Key header.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ORCH_API_KEYS=CHANGE_ME_local_dev_key
ORCH_API_REQUIRE_AUTH=true

# --- Concurrency limits ---
ORCH_MAX_CONCURRENT_EXECUTIONS=8
ORCH_MAX_CONCURRENT_AGENTS=16
ORCH_MAX_CONCURRENT_TOOLS=32

# --- Default execution budget (per execution; overridable per request) ---
ORCH_BUDGET_MAX_COST_USD=0.50
ORCH_BUDGET_MAX_TOKENS=50000
ORCH_BUDGET_MAX_DURATION_SECONDS=300
ORCH_BUDGET_MAX_AGENT_STEPS=30
ORCH_BUDGET_MAX_TOOL_CALLS=60
ORCH_BUDGET_MAX_RETRIES=10

# --- LLM providers -------------------------------------------------------
# Default provider used when a ModelConfig does not pin one.
# `mock` is fully deterministic and needs no network or credentials.
ORCH_DEFAULT_PROVIDER=mock           # mock | openai | anthropic | gemini | ollama | groq

# Leave blank to disable a provider. Never commit real keys.
ORCH_OPENAI_API_KEY=
ORCH_OPENAI_BASE_URL=https://api.openai.com/v1
ORCH_ANTHROPIC_API_KEY=
ORCH_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ORCH_GEMINI_API_KEY=
ORCH_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ORCH_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Groq speaks the same OpenAI-compatible /chat/completions shape as OpenAI --
# e.g. openai/gpt-oss-120b, openai/gpt-oss-20b, llama-3.3-70b-versatile.
ORCH_GROQ_API_KEY=
ORCH_GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional: force every routing decision (the supervisor's included) onto one
# specific model catalog key, bypassing the router's cost/capability-based
# selection entirely. Leave blank to let the router choose per call as usual.
ORCH_PINNED_MODEL_KEY=

ORCH_LLM_TIMEOUT_SECONDS=60
ORCH_LLM_MAX_RETRIES=3

# --- Observability ---
ORCH_TRACING_ENABLED=true
ORCH_TRACE_EXPORTER=none             # none | console | otlp
ORCH_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
ORCH_METRICS_ENABLED=true
ORCH_SERVICE_NAME=agent-orchestration-engine

# --- Safety switches (see docs/security.md) ---
# Shell execution is NOT registered as a tool unless this is explicitly true.
# Leave false. There is no sandbox; enabling it grants arbitrary code execution.
ORCH_ENABLE_SHELL_TOOL=false
ORCH_ENABLE_PYTHON_TOOL=true
ORCH_PYTHON_TOOL_TIMEOUT_SECONDS=10
ORCH_APPROVAL_TIMEOUT_SECONDS=3600
# Filesystem tools are confined to this root; path escapes are rejected.
ORCH_FILE_SANDBOX_ROOT=./.artifacts
