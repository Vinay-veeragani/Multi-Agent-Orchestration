# Overrides for `docker compose up`, kept separate from the bare-metal
# `.env` (which sets ORCH_* variables for a host-installed PostgreSQL/Redis
# and would otherwise be auto-loaded by Compose CLI and shadow these).
#
# Usage:
#   cp docker/.env.docker.example docker/.env.docker
#   docker compose --env-file docker/.env.docker up --build
#
# Anything left unset here falls back to docker-compose.yml's own
# development-only defaults.

COMPOSE_POSTGRES_USER=orchestrator
COMPOSE_POSTGRES_PASSWORD=CHANGE_ME
COMPOSE_POSTGRES_DB=orchestration

# Host port mappings, in case 5432/6379/8000 are already taken locally.
COMPOSE_POSTGRES_PORT=5432
COMPOSE_REDIS_PORT=6379
COMPOSE_API_PORT=8000

# Comma-separated API keys the deployed service accepts via X-API-Key.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
COMPOSE_API_KEYS=CHANGE_ME

# Leave blank to keep the container mock-only (no LLM key configured yet).
COMPOSE_OPENAI_API_KEY=
COMPOSE_ANTHROPIC_API_KEY=
COMPOSE_GEMINI_API_KEY=
