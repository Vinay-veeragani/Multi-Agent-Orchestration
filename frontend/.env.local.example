# Copy to .env.local for local development.
#
# Server-side only (no NEXT_PUBLIC_ prefix): these are read by Server
# Components and Route Handlers, never sent to the browser bundle. The
# orchestrator API key therefore never reaches client-side JavaScript --
# every browser request goes through this app's own same-origin routes,
# which attach the key when they call the real API.
ORCHESTRATOR_API_URL=http://127.0.0.1:8000
ORCHESTRATOR_API_KEY=local_dev_key_change_me
